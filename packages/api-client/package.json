{
  "name": "@doclens/api-client",
  "version": "0.1.0-dev",
  "private": true,
  "description": "Type-safe DocLens API client generated from openapi.yaml.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/generated/schema.ts"
  },
  "scripts": {
    "gen": "openapi-typescript ../../apps/api/openapi.yaml -o src/generated/schema.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "echo 'no tests yet' && exit 0"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.4.0",
    "typescript": "^5.5.4"
  }
}
