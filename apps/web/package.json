{
  "name": "@doclens/web",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit",
