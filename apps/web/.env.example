# Web app environment.
#
# Copy to .env.local and fill in. .env.local is gitignored.
# Production vars come from the deployment platform, not from disk.

# --- Clerk -------------------------------------------------------------
# Create a Clerk application at https://dashboard.clerk.com and paste
# both keys here. NEXT_PUBLIC_ vars are inlined at build time.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Where Clerk redirects after sign-in / sign-up. Default to /library.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/library
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/library

# --- DocLens API -------------------------------------------------------
# Browser-visible base URL for client-side fetches.
NEXT_PUBLIC_API_URL=http://localhost:8080
# Server-side base URL used by Server Components. May differ in Docker
# Compose setups where the api service is reachable as `http://api:8080`.
INTERNAL_API_URL=http://localhost:8080

# Used by next-metadata's metadataBase. Optional in development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
